{
  "name": "@feizk/cache",
  "version": "1.2.3",
  "description": "Type-safe, multi-backend caching library for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublish": "tsup"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fakeredis": "^2.0.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@feizk/kit": "1.0.2",
    "@feizk/logger": "^2.0.2",
    "ioredis": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cache",
    "redis",
    "lru",
    "ttl",
    "typescript",
    "caching"
  ],
  "author": "feizk",
  "license": "MIT"
}
