{
  "name": "@feizk/logger-discord",
  "version": "1.0.0",
  "description": "Discord transport plugin for @feizk/logger",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "peerDependencies": {
    "@feizk/logger": "^2.0.0"
  },
  "devDependencies": {
    "@feizk/logger": "^2.0.0",
    "@types/node": "^20.0.0",
    "vitest": "^1.6.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "logger",
    "discord",
    "webhook",
    "transport",
    "@feizk"
  ],
  "author": "feizk",
  "license": "MIT"
}
