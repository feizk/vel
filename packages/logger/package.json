{
  "name": "@feizk/logger",
  "version": "2.0.0",
  "description": "A lightweight, pluggable logger with colored outputs, structured logging, and transport support",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "tsc": "tsc",
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^1.6.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "logger",
    "console",
    "colors",
    "timestamps",
    "structured-logging",
    "transports"
  ],
  "author": "feizk",
  "license": "MIT"
}
